rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerifiedUser() {
      return isSignedIn();
    }
    
    function isBUUser() {
      return isVerifiedUser() && request.auth.token.email != null && (
        request.auth.token.email.matches('(?i)^.+@bu\\.ac\\.th$') ||
        request.auth.token.email.matches('.*@bu\\.ac\\.th$') ||
        request.auth.token.email.matches('.*@BU\\.AC\\.TH$')
      );
    }
    
    // Bootstrapped Admin: User email from runtime "walailuk.p@bu.ac.th" and specific admin placeholders under @bu.ac.th
    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email != null && (
        request.auth.token.email == 'walailuk.p@bu.ac.th' ||
        request.auth.token.email == 'Walailuk.p@bu.ac.th' ||
        request.auth.token.email == 'walailuk.P@bu.ac.th' ||
        request.auth.token.email == 'Walailuk.P@bu.ac.th' ||
        request.auth.token.email.matches('(?i)^walailuk\\.p@bu\\.ac\\.th$') ||
        request.auth.token.email.matches('(?i)^admin1@bu\\.ac\\.th$') ||
        request.auth.token.email.matches('(?i)^admin2@bu\\.ac\\.th$') ||
        request.auth.token.email.matches('(?i)^admin[0-9]+@bu\\.ac\\.th$') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }

    // --- Entity: Question ---
    match /questions/{questionId} {
      allow read: if isBUUser();
      allow create, update, delete: if isAdmin();
    }

    // --- Entity: Response ---
    match /responses/{responseId} {
      allow create: if isBUUser() && isValidId(responseId);
      allow read: if isAdmin() || (isBUUser() && (resource.data.respondentEmail == request.auth.token.email || resource.data.respondentEmail.lower() == request.auth.token.email.lower()));
      allow delete: if isAdmin();
    }

    // --- Entity: AdminProfile ---
    match /admins/{adminEmail} {
      allow read: if isAdmin() || (isBUUser() && request.auth.token.email.lower() == adminEmail.lower());
      allow write: if isAdmin();
    }

    // --- Entity: Instructor ---
    match /instructors/{instructorEmail} {
      allow read: if isAdmin() || (isBUUser() && (request.auth.token.email == instructorEmail || request.auth.token.email.matches('(?i)^' + instructorEmail + '$')));
      allow write: if isAdmin();
    }
  }
}
